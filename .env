# PostgreSQL 설정
DATABASE_URL=postgresql://postgres:0213@localhost:5432/yourdb

# 일반적으로 mysql 설정도 남겨두면 좋음 (Railway 대비)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=0213
DB_NAME=yourdb

# JWT 등 인증 키
JWT_SECRET=hellohamsecretkey
JWT_REFRESH_SECRET=superduperrefreshsecret

# 개발/배포 구분용
NODE_ENV=development